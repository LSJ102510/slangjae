{
  "redirects": [
    {
      "source": "/",
      "destination": "/archives/lab",
      "permanent": false
    },
    {
      "source": "/((?!archives/lab$|archives/[^/]+(?:/photos(?:/[^/]+)?)?$|assets/|favicon\\.svg$|index\\.html$).*)",
      "destination": "/archives/lab",
      "permanent": false
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
